    <string name="maint_title">Printer maintenance</string>
    <string name="maint_hint">Streaky prints or missing colours usually mean clogged nozzles. Check first, clean only if it turns out to be needed.</string>
    <string name="maint_variant_title">Command form</string>
    <string name="maint_variant_default">Standard</string>
    <string name="maint_variant_legacy">Legacy</string>
    <string name="maint_variant_hint">Standard follows the form used by the official Epson driver, and that is the one proven to work on the L3110. Legacy is there for models that do not answer the standard form. The bytes sent are recorded in the Notes card.</string>
    <string name="maint_nozzle">Nozzle check</string>
    <string name="maint_nozzle_confirm">The printer will print a nozzle check pattern. Put one sheet of paper in the tray.</string>
    <string name="maint_clean">Clean head</string>
    <string name="maint_clean_confirm">Head cleaning uses a fair amount of ink and takes about a minute. Do it only if the nozzle check really is broken up, and do not repeat it over and over.</string>
    <string name="maint_eject">Eject paper</string>
    <string name="maint_eject_confirm">The printer will feed the paper until it comes out. Use this when a sheet is stuck inside.</string>

